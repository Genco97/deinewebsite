# Supabase – Projekt-URL und öffentlicher Anon-Key (dürfen im Browser landen)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUR serverseitig verwenden – niemals mit NEXT_PUBLIC_ präfixen!
SUPABASE_SERVICE_ROLE_KEY=

# Öffentliche Adresse der Seite (für Einladungslinks und Redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
